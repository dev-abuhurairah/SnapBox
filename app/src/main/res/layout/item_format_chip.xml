<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root_format"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="6dp"
    android:background="@drawable/bg_format_chip"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="14dp"
    android:paddingVertical="10dp">

    <ImageView
        android:id="@+id/iv_radio"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:src="@drawable/ic_check"
        android:visibility="invisible"
        app:tint="@color/snaptube_yellow" />

    <TextView
        android:id="@+id/tv_format_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:textColor="@color/text_primary"
        android:textSize="14sp"
        android:textStyle="bold"
        tools:text="1080p FHD" />

    <TextView
        android:id="@+id/tv_format_ext"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="10dp"
        android:textColor="@color/text_muted"
        android:textSize="12sp"
        tools:text="MP4" />

    <TextView
        android:id="@+id/tv_format_size"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/snaptube_yellow"
        android:textSize="13sp"
        tools:text="45.2 MB" />

</LinearLayout>

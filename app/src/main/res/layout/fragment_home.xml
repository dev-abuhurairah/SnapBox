<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <!-- Ambient Faded Mosaic Background (Top Half) -->
    <ImageView
        android:id="@+id/iv_ambient_bg"
        android:layout_width="0dp"
        android:layout_height="320dp"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_home_ambient"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Top Navigation Tabs (Search, YouTube, Music, More) -->
    <LinearLayout
        android:id="@+id/top_category_tabs"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="24dp"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Search Tab (Active) -->
        <LinearLayout
            android:id="@+id/tab_search"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="Search"
                android:textColor="@color/white"
                android:textSize="15sp" />

            <View
                android:layout_width="28dp"
                android:layout_height="2.5dp"
                android:layout_marginTop="4dp"
                android:background="@color/snaptube_yellow" />
        </LinearLayout>

        <!-- YouTube Tab -->
        <TextView
            android:id="@+id/tab_youtube"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="sans-serif"
            android:padding="8dp"
            android:text="YouTube"
            android:textColor="@color/text_secondary"
            android:textSize="15sp" />

        <!-- Music Tab -->
        <TextView
            android:id="@+id/tab_music"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="sans-serif"
            android:padding="8dp"
            android:text="Music"
            android:textColor="@color/text_secondary"
            android:textSize="15sp" />

        <!-- More Tab -->
        <TextView
            android:id="@+id/tab_more"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="sans-serif"
            android:padding="8dp"
            android:text="More"
            android:textColor="@color/text_secondary"
            android:textSize="15sp" />
    </LinearLayout>

    <!-- Center Content: Brand Logo & Pill Search Box -->
    <LinearLayout
        android:id="@+id/center_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/top_category_tabs"
        app:layout_constraintVertical_bias="0.32">

        <!-- Bold Snaptube Brand Wordmark -->
        <TextView
            android:id="@+id/tv_brand_logo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-black"
            android:letterSpacing="-0.02"
            android:text="SnapBox"
            android:textColor="@color/snaptube_yellow"
            android:textSize="40sp" />

        <!-- Snaptube Pill Search Bar -->
        <LinearLayout
            android:id="@+id/layout_search_pill"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="32dp"
            android:background="@drawable/bg_search_pill"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="6dp">

            <!-- Download Tray Icon -->
            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_tray_download"
                app:tint="#888888" />

            <!-- Input / Search Query -->
            <EditText
                android:id="@+id/et_search_input"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@null"
                android:hint="Search to download"
                android:imeOptions="actionSearch"
                android:inputType="textUri|text"
                android:maxLines="1"
                android:textColor="@color/text_primary"
                android:textColorHint="#757575"
                android:textSize="15sp" />

            <!-- Quick Paste Chip Button inside bar -->
            <TextView
                android:id="@+id/btn_home_paste"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="6dp"
                android:text="Paste"
                android:textColor="@color/snaptube_yellow"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- Yellow Circular Search Button -->
            <ImageButton
                android:id="@+id/btn_search_circle"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_yellow_circle_btn"
                android:contentDescription="Search"
                android:src="@drawable/ic_search_btn" />
        </LinearLayout>

        <!-- Loading Indicator Card -->
        <LinearLayout
            android:id="@+id/layout_extracting"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_card_dark"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp"
            android:visibility="gone"
            tools:visibility="visible">

            <ProgressBar
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:indeterminateTint="@color/snaptube_yellow" />

            <TextView
                android:id="@+id/tv_extracting_status"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:text="Analyzing link with yt-dlp..."
                android:textColor="@color/text_primary"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Subtle Supported Sites Hint -->
        <TextView
            android:id="@+id/tv_supported_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:text="Supports Instagram Reels, YouTube, TikTok, Facebook, X &amp; 1000+ sites"
            android:textColor="#555555"
            android:textSize="12sp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="360dp"
    android:height="260dp"
    android:viewportWidth="360"
    android:viewportHeight="260">

    <!-- Solid Dark Base -->
    <path
        android:fillColor="#121212"
        android:pathData="M0,0h360v260h-360z"/>

    <!-- Subtle Golden-Amber Radial Glow behind brand wordmark -->
    <path
        android:pathData="M0,0h360v260h-360z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:centerX="180"
                android:centerY="80"
                android:gradientRadius="180"
                android:startColor="#14FFC800"
                android:centerColor="#05FFC800"
                android:endColor="#00121212"
                android:type="radial"/>
        </aapt:attr>
    </path>

    <!-- Smooth Dark Linear Gradient fading down into the canvas -->
    <path
        android:pathData="M0,0h360v260h-360z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startY="0"
                android:endY="260"
                android:startColor="#00121212"
                android:centerColor="#80121212"
                android:endColor="#FF121212"
                android:type="linear"/>
        </aapt:attr>
    </path>
</vector>